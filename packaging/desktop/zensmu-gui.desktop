[Desktop Entry]
Version=1.0
Type=Application
Name=zensmu
GenericName=AMD Ryzen SMU Monitor & Tuner
Comment=Safety-first AMD Ryzen SMU telemetry, Curve Optimizer, and PBO/APU control
